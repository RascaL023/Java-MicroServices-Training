services:
  kong-migrations:
      image: kong:3.6
      extra_hosts:
        - "host.docker.internal:host-gateway"
      environment:
        KONG_DATABASE: postgres
        KONG_PG_HOST: host.docker.internal
        KONG_PG_PORT: 5555
        KONG_PG_USER: rascal
        KONG_PG_PASSWORD: ''
        KONG_PG_DATABASE: kong
      command: kong migrations bootstrap

  kong:
    image: kong:3.6
    network_mode: host
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - kong-migrations
    environment:
      KONG_DATABASE: postgres
      KONG_PG_HOST: 127.0.0.1
      KONG_PG_PORT: 5555
      KONG_PG_USER: rascal
      KONG_PG_PASSWORD: ''
      KONG_PG_DATABASE: kong
      KONG_PROXY_LISTEN: 0.0.0.0:8000
      KONG_ADMIN_LISTEN: 0.0.0.0:8001
    ports:
      - "8000:8000"
      - "8001:8001"
